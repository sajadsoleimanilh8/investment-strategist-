# Copy to .env and fill in. app/core/config.py loads it via pydantic-settings.

# --- runtime ---
DEMO_MODE=true                 # true => no external APIs required, seeded data, mock market
ENV=dev
LOG_LEVEL=INFO

# --- background jobs ---
ENABLE_SCHEDULER=true           # APScheduler warms the market cache on an interval
# The public live-price WebSocket behind the landing page's market panel.
#   live  real prices from CoinGecko (ignored under DEMO_MODE, which cannot
#         reach anything external — it resolves to off)
#   mock  synthetic ticks, rendered with a "Demo data" label
#   off   no poll loop; the panel says so and shows no price
MARKET_LIVE_SOURCE=live

# --- email ---
# console logs the message (including the reset link) instead of sending it,
# which is what keeps a password reset completable with nothing reachable.
# The API refuses to start on console outside DEMO_MODE: a link in a log is a
# bearer credential anyone with log access can spend.
MAIL_TRANSPORT=console          # console | smtp
MAIL_FROM=FinMentor <no-reply@finmentor.local>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Where a reset link points. The SPA, not the API: in a split deployment they
# are different origins, and the link has to open a page.
WEB_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60

# --- third-party sign-in ---
# Leave a provider's credentials blank and its button does not appear. The
# redirect base must match what is registered with each provider exactly,
# including the scheme; it is the API's own origin, not the SPA's.
OAUTH_REDIRECT_BASE=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple: the client id is the Services ID (not the app id), and the secret is
# a JWT signed from the .p8 key rather than a stored string, so all four parts
# are needed before the button appears.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- presentation ---
CURRENCY_SYMBOL=$               # every money string is rendered with this

# --- database ---
DATABASE_URL=postgresql+psycopg://finmentor:finmentor@localhost:5432/finmentor
REDIS_URL=redis://localhost:6379/0

# --- web auth ---
# JWT_SECRET is REQUIRED outside DEMO_MODE — the app refuses to start on this
# development default with DEMO_MODE=false. Generate a real one with either of:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# It belongs in .env or your platform's secret store. Never in source, never in
# an image, never in docker-compose.yml. Rotating it signs every session out,
# which is what you want if it leaks.
JWT_SECRET=dev-only-not-a-secret-please-replace-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
AUTH_RATE_LIMIT_PER_MINUTE=10
ASK_RATE_LIMIT_PER_MINUTE=20

# --- telegram ---
TELEGRAM_BOT_TOKEN=your-token-from-botfather
# The bot's @name without the @. Only used to build the deep link that saves a
# user typing the link code by hand. Unset is fine: the web page then shows the
# code and no button, which still works.
TELEGRAM_BOT_USERNAME=
# A link code is read off one screen and typed into another, so it is short
# lived by design. Ten minutes covers "open Telegram, find the bot, paste".
TELEGRAM_LINK_TTL_MINUTES=10
TELEGRAM_LINK_ATTEMPTS_PER_MINUTE=5

# --- market data ---
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CACHE_TTL_SECONDS=3600
# The refresh runs at this fraction of the TTL, never at the TTL itself:
# replacing a snapshot at the moment it expires leaves a gap every cycle.
MARKET_REFRESH_FRACTION=0.5
# With more than one replica, only the lease holder runs the scheduled jobs.
# Without Redis every replica runs, which is right for a single container.
SCHEDULER_LEASE_SECONDS=300

# --- retention (nothing here is bounded by what a user does) ---
RETENTION_MARKET_SNAPSHOTS_PER_SYMBOL=5   # a cache; only the newest is read
RETENTION_PASSWORD_RESET_DAYS=7           # after expiry, a spent link's row
RETENTION_SIMULATIONS_PER_USER=500        # the user's own runs: a runaway
                                          # guard, not a retention policy
RETENTION_INTERVAL_SECONDS=86400

# --- local LLM (default engine) ---
LOCAL_LLM_PROVIDER=ollama       # ollama | fake (fake = deterministic test double)
LOCAL_LLM_MODEL=qwen2.5:7b    # any Ollama tag; see scripts/ft/README.md for the probe scorecard
# LOCAL_LLM_MODEL=llama3.2:3b   # the original default — 3x smaller, ~15% faster, scored 4pp lower
# LOCAL_LLM_MODEL=finmentor-3b  # the QLoRA fine-tune; build it with scripts/ft/train.py + export.py
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_TEMPERATURE=0.3       # the model explains verified numbers; keep it low
AI_MAX_TOKENS=300               # runaway guard; prompts ask for concise-by-default, not a fixed length
# /ai/ask is synchronous, so each generation holds a threadpool worker. Was 60s
# with no ceiling, which let slow calls stall every other route in the process.
LOCAL_LLM_TIMEOUT_SECONDS=20
LOCAL_LLM_MAX_CONCURRENCY=4     # past this, callers drop to the deterministic tier
AI_CHAT_HISTORY_TURNS=6    # past turns the free-chat path sees; precise answers stay stateless

# --- remote LLM (optional enhancement; keep disabled to run local-only) ---
REMOTE_LLM_ENABLED=false
REMOTE_LLM_PROVIDER=none        # openai | anthropic | none
REMOTE_LLM_MODEL=gpt-4o-mini
REMOTE_LLM_API_KEY=
REMOTE_LLM_TIMEOUT_SECONDS=8
