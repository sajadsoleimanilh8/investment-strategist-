# Copy to .env and fill in. app/core/config.py loads it via pydantic-settings.

# --- runtime ---
DEMO_MODE=true                 # true => no external APIs required, seeded data, mock market
ENV=dev
LOG_LEVEL=INFO

# --- presentation ---
CURRENCY_SYMBOL=$               # every money string is rendered with this

# --- database ---
DATABASE_URL=postgresql+psycopg://finmentor:finmentor@localhost:5432/finmentor
REDIS_URL=redis://localhost:6379/0

# --- telegram ---
TELEGRAM_BOT_TOKEN=your-token-from-botfather

# --- market data ---
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CACHE_TTL_SECONDS=3600

# --- local LLM (default engine) ---
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- remote LLM (optional enhancement; keep disabled to run local-only) ---
REMOTE_LLM_ENABLED=false
REMOTE_LLM_PROVIDER=none        # openai | anthropic | none
REMOTE_LLM_MODEL=gpt-4o-mini
REMOTE_LLM_API_KEY=
REMOTE_LLM_TIMEOUT_SECONDS=8
