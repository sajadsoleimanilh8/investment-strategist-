# Copy to .env and fill in. app/core/config.py loads it via pydantic-settings.

# --- runtime ---
DEMO_MODE=true                 # true => no external APIs required, seeded data, mock market
ENV=dev
LOG_LEVEL=INFO

# --- background jobs ---
ENABLE_SCHEDULER=true           # APScheduler warms the market cache on an interval

# --- presentation ---
CURRENCY_SYMBOL=$               # every money string is rendered with this

# --- database ---
DATABASE_URL=postgresql+psycopg://finmentor:finmentor@localhost:5432/finmentor
REDIS_URL=redis://localhost:6379/0

# --- web auth ---
# JWT_SECRET is REQUIRED outside DEMO_MODE — the app refuses to start on this
# development default with DEMO_MODE=false. Generate a real one with either of:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# It belongs in .env or your platform's secret store. Never in source, never in
# an image, never in docker-compose.yml. Rotating it signs every session out,
# which is what you want if it leaks.
JWT_SECRET=dev-only-not-a-secret-please-replace-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
AUTH_RATE_LIMIT_PER_MINUTE=10
ASK_RATE_LIMIT_PER_MINUTE=20

# --- telegram ---
TELEGRAM_BOT_TOKEN=your-token-from-botfather

# --- market data ---
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CACHE_TTL_SECONDS=3600

# --- local LLM (default engine) ---
LOCAL_LLM_PROVIDER=ollama       # ollama | fake (fake = deterministic test double)
LOCAL_LLM_MODEL=qwen2.5:7b    # any Ollama tag; see scripts/ft/README.md for the probe scorecard
# LOCAL_LLM_MODEL=llama3.2:3b   # the original default — 3x smaller, ~15% faster, scored 4pp lower
# LOCAL_LLM_MODEL=finmentor-3b  # the QLoRA fine-tune; build it with scripts/ft/train.py + export.py
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_TEMPERATURE=0.3       # the model explains verified numbers; keep it low
AI_MAX_TOKENS=160               # hard length ceiling; prompts also ask for 1-2 sentences
AI_CHAT_HISTORY_TURNS=6    # past turns the free-chat path sees; precise answers stay stateless

# --- remote LLM (optional enhancement; keep disabled to run local-only) ---
REMOTE_LLM_ENABLED=false
REMOTE_LLM_PROVIDER=none        # openai | anthropic | none
REMOTE_LLM_MODEL=gpt-4o-mini
REMOTE_LLM_API_KEY=
REMOTE_LLM_TIMEOUT_SECONDS=8
