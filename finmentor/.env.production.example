# Copy to .env.production and fill in every value. Never commit the real file;
# .gitignore covers it. Generate secrets with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 64 hex characters: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# A real mail transport is required: the app refuses to start outside DEMO_MODE
# on the console one, because a reset link in a log is a usable credential.
MAIL_FROM=FinMentor <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# From @BotFather. A production token, not the one you developed with.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ALPHA_VANTAGE_API_KEY=
